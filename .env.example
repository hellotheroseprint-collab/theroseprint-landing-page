# Kit (formerly ConvertKit) inline form embed — paste the data-uid value from your Kit form embed code.
VITE_KIT_FORM_UID=your_form_uid_here

# Payhip digital product — from Share / Embed (the /b/XXXX or data-product code).
# Leave empty to show the guide section with a “checkout coming soon” state.
VITE_PAYHIP_PRODUCT_ID=

# Optional. Defaults to https://payhip.com/buy?link=PRODUCT_ID when the product ID is set.
# VITE_GUIDE_CHECKOUT_URL=https://payhip.com/buy?link=XXXX

# Free starter guide — the $0 Payhip product that captures the email and sends the PDF.
VITE_PAYHIP_FREE_PRODUCT_ID=LzXQf
